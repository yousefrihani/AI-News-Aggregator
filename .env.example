# ==============================================================================
# Environment Configuration for AI-News-Aggregator
# ==============================================================================
# Copy this file to '.env' and fill in your actual credentials.
# Note: '.env' is ignored by git and will never be committed.

# FreeNewsApi.io API Credentials
# Register at https://www.freenewsapi.io to obtain your x-api-key
FREENEWSAPI_API_KEY=your_freenewsapi_key_here

# Alternative/Fallback News API Keys
NEWS_API_KEY=your_fallback_news_key_here

# Future / Paper Ingestion APIs (e.g. Semantic Scholar, etc.)
# SEMANTIC_SCHOLAR_API_KEY=
