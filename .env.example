# ==============================================================================
# Environment configuration for AI-News-Aggregator
# ==============================================================================
# Copy this file to `.env` and replace placeholders with your own values.
# `.env` is gitignored: never commit real credentials.
# This template contains placeholders only.

# --- News provider credentials -------------------------------------------------
# FreeNewsApi.io (https://www.freenewsapi.io) primary key, sent as `x-api-key`.
FREENEWSAPI_API_KEY=your_freenewsapi_key_here

# Generic fallback keys, used only when FREENEWSAPI_API_KEY is unset.
# Precedence: explicit argument -> FREENEWSAPI_API_KEY -> NEWS_API_KEY -> NEWSAPI_KEY.
NEWS_API_KEY=your_fallback_news_key_here
NEWSAPI_KEY=your_second_fallback_key_here

# --- Future providers ----------------------------------------------------------
# Semantic Scholar paper ingestion is planned; leave commented until enabled.
# SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_key_here

# --- LLM routing ---------------------------------------------------------------
# Copy config/llm_routes.example.yaml to config/llm_routes.yaml and choose the
# providers/routes you want. Keys are read only from the environment.
GROQ_API_KEY=your_groq_key_here
OPENROUTER_API_KEY=your_openrouter_key_here
# AI_NEWS_LLM_ROUTES_FILE=config/llm_routes.yaml
# AI_NEWS_LLM_ROUTE=summarize
# Pin a provider/model explicitly, overriding route order.
# AI_NEWS_LLM_PROVIDER=groq
# AI_NEWS_LLM_MODEL=fast
# Allow fallback to the route candidates when a provider/model is pinned.
# AI_NEWS_LLM_ALLOW_FALLBACK=0
# Return fixture responses without calling any provider.
# LLM_DRY_RUN=0

# --- Tests ---------------------------------------------------------------------
# Set to 1 to opt into live end-to-end tests (requires a real API key).
# Default is 0: the unit test suite never touches the network.
RUN_E2E=0

# --- Runtime settings (read by Articles.config) --------------------------------
# AI_NEWS_* variables are validated at startup; invalid values raise
# ProviderConfigError instead of silently using an unsafe default.
AI_NEWS_HTTP_TIMEOUT=10.0
AI_NEWS_MAX_CONCURRENCY=5
AI_NEWS_MAX_PAGES=10
AI_NEWS_MAX_ITEMS=500
AI_NEWS_PAGE_SIZE=50

# Comma-separated default topics used when --topic is not supplied.
AI_NEWS_TOPICS=technology

# --- Docker Compose ------------------------------------------------------------
# Articles requested by the `app` service when no --limit is passed.
ARTICLE_LIMIT=20
